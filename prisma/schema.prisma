generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // Stored as JSON string
  updatedAt DateTime @updatedAt
}

model Admin {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String    // Hashed password
  name                  String?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?   // Base32 TOTP secret
  twoFactorRecoveryCodes String?  // JSON string array of bcrypt-hashed recovery codes
  twoFactorEnabledAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Collection {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  bannerUrl    String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  description      String
  fabricDetails    String?
  careInstructions String?
  basePrice        Float
  discountPrice    Float?
  sku              String           @unique
  barcode          String?          @unique
  status           String           @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED
  publishedAt      DateTime         @default(now())
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(true)
  isBestSeller     Boolean          @default(false)
  isSignature      Boolean          @default(false)
  inStock          Boolean          @default(true)
  stockQuantity    Int              @default(25)
  reservedStock    Int              @default(0)
  weightGram       Int?             @default(800)
  lengthCm         Float?           @default(35)
  widthCm          Float?           @default(25)
  heightCm         Float?           @default(5)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collectionId     String?
  collection       Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sizeGuideId      String?
  sizeGuide        SizeGuide?       @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  inventoryLogs    InventoryLog[]
  // Pre-order Fields
  isPreOrder                    Boolean  @default(false)
  preOrderAdvancePercent        Int?     // e.g. 50 (overrides global setting if set)
  preOrderNote                  String?  // Displayed on product page/checkout
  preOrderEstimatedAvailability String?  // e.g. "November 2026"
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([inStock])
  @@index([stockQuantity])
  @@index([categoryId])
  @@index([collectionId])
  @@index([createdAt])
  @@index([isPreOrder])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ProductVariant {
  id            String         @id @default(uuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  color         String
  colorHex      String?
  sku           String         @unique
  barcode       String?
  stock         Int            @default(10)
  reserved      Int            @default(0)
  inventoryLogs InventoryLog[]
  createdAt     DateTime       @default(now())
}

model Customer {
  id                String    @id @default(uuid())
  fullName          String
  phone             String    @unique
  whatsapp          String?
  email             String?
  province          String?
  city              String?
  address           String?
  postalCode        String?
  totalSpent        Float     @default(0)
  ordersCount       Int       @default(0)
  averageOrderValue Float     @default(0)
  lastOrderDate     DateTime?
  customerNotes     String?
  isVIP             Boolean   @default(false)
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isVIP])
  @@index([totalSpent])
  @@index([createdAt])
}

model Order {
  id               String              @id @default(uuid())
  orderNumber      String              @unique
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String
  customerWhatsapp String?
  customerEmail    String?
  shippingProvince String
  shippingCity     String
  shippingAddress  String
  postalCode       String?
  orderNotes       String?
  internalAdminNote String?
  subtotal         Float
  discountAmount   Float               @default(0)
  shippingFee      Float               @default(0)
  totalAmount      Float
  paymentMethod    String              @default("CASH_ON_DELIVERY")
  status           String              @default("PENDING") // PENDING, CONFIRMED, PACKING, DISPATCHED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED
  trackingNumber   String?
  courier          String?             // PostEx, TCS, Leopards, M&P, Other
  codCharges       Float               @default(0)
  couponCode       String?
  isReadByAdmin    Boolean             @default(false)
  amountPaid       Float               @default(0) // 0 until payment approved (for Pre-orders, equals advance amount; for COD, paid at delivery)
  // Pre-order Payment Fields
  isPreOrder                        Boolean   @default(false)
  preOrderPaymentStatus             String?   // PAYMENT_REVIEW_PENDING | PAYMENT_APPROVED | PAYMENT_REJECTED
  preOrderPaymentMethodName         String?   // e.g. "Easypaisa", "JazzCash", "Bank Transfer"
  preOrderPaymentScreenshotUrl      String?   // Internal storage path (NOT exposed publicly)
  preOrderAdvancePercent            Int?      // Snapshot of % at time of order
  preOrderAdvanceAmount             Float?    // Advance required (server-calculated, stored in paisa-safe integer cents equiv)
  preOrderRemainingAmount           Float?    // Remaining at delivery
  preOrderPaymentVerifiedAt         DateTime?
  preOrderPaymentVerifiedBy         String?   // Admin email/name who approved
  preOrderPaymentRejectionReason    String?
  preOrderPaymentRejectedAt         DateTime?
  preOrderPaymentRejectedBy         String?

  // Order Confirmation & Lifecycle Fields
  confirmedAt                       DateTime?
  confirmedBy                       String?   // Admin email/name who confirmed

  // WhatsApp State-Driven Lifecycle Fields
  confirmationWhatsAppSentAt        DateTime?
  confirmationWhatsAppMessageId     String?
  trackingWhatsAppSentAt            DateTime?
  trackingWhatsAppMessageId         String?
  deliveredWhatsAppSentAt           DateTime?
  deliveredWhatsAppMessageId        String?
  deliveredAt                       DateTime?

  items            OrderItem[]
  notifications    AdminNotification[]
  timeline         OrderTimeline[]
  notificationLogs NotificationLog[]
  shipments        Shipment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([trackingNumber])
  @@index([courier])
  @@index([isPreOrder])
  @@index([preOrderPaymentStatus])
  @@index([confirmedAt])
  @@index([confirmationWhatsAppSentAt])
  @@index([trackingWhatsAppSentAt])
  @@index([deliveredWhatsAppSentAt])
  @@index([deliveredAt])
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String    @default("POSTEX") // POSTEX, MANUAL, TCS, LEOPARDS
  trackingNumber     String?
  externalShipmentId String?
  status             String    @default("PENDING") // PENDING, CREATED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED
  labelUrl           String?
  trackingUrl        String?
  codAmount          Float     @default(0)
  metadata           String?   // JSON string for provider payload

  // Extended PostEx Courier Fields
  orderRefNumber     String?
  transactionFee     Float?
  fuelSurcharge      Float?
  taxAmount          Float?
  settlementStatus   String?   // PENDING, SETTLED, UNPAID, PARTIAL, etc.
  settlementDate     DateTime?
  cprNumber          String?   // CPR (Cheque/Payment Reference) number from PostEx
  upfrontPaymentDate DateTime?
  reservePaymentDate DateTime?
  pickupDate         DateTime?
  deliveryDate       DateTime?
  returnDate         DateTime?
  returnReason       String?
  apiResponse        String?   // Full raw JSON response for audit/debugging

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([externalShipmentId])
  @@index([status])
  @@index([settlementStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  variantInfo  String?
  unitPrice    Float
  originalPrice Float?   // Original retail price before discount
  quantity     Int
  subtotal     Float
}

model OrderTimeline {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String
  previousStatus String?
  note           String?
  updatedBy      String   @default("System Admin")
  createdAt      DateTime @default(now())
}

model InventoryLog {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  changeQuantity Int             // positive for restock, negative for deduction
  stockAfter     Int
  reason         String          // ORDER_PLACED, RESTOCK, MANUAL_ADJUSTMENT, RETURN
  createdAt      DateTime        @default(now())

  @@index([productId])
  @@index([reason])
  @@index([createdAt])
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  discountType      String    // PERCENTAGE or FIXED
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  usageLimit        Int?
  usedCount         Int       @default(0)
  expiryDate        DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([isActive])
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int      @default(5)
  comment      String
  imageUrl     String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
  @@index([createdAt])
}

model AdminNotification {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   @default("NEW_ORDER") // NEW_ORDER, ORDER_CANCELLED, LOW_STOCK, CONTACT_SUBMITTED
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())

  @@index([entity, action, createdAt])
  @@index([ipAddress, createdAt])
}

model ShippingRule {
  id                    String  @id @default(uuid())
  city                  String  @unique
  province              String
  charge                Float   @default(250)
  freeShippingMinAmount Float   @default(10000)
}

model NotificationLog {
  id                String   @id @default(uuid())
  orderId           String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientPhone    String
  messageType       String   // CONFIRMATION_REQUEST, CONFIRMATION_SUCCESS, STATUS_UPDATE, ADMIN_ALERT
  provider          String   @default("WHATSAPP") // WHATSAPP, EMAIL, SMS
  payload           String?  // JSON formatted message body or template params
  status            String   @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  whatsappMessageId String?
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)
  lastAttemptAt     DateTime?
  errorDetails      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────
// Size Guide System
// ─────────────────────────────────────────────────────

model SizeGuide {
  id              String           @id @default(uuid())
  name            String           // e.g. "Pret", "Unstitched", "Kaftan", "Abaya"
  slug            String           @unique
  description     String?          // Optional intro text
  productType     String           @default("STITCHED") // STITCHED, UNSTITCHED
  measurementUnit String           @default("inches") // inches, cm
  columns         String           // JSON array of column names e.g. ["Bust","Waist","Hip","Length"]
  isDefault       Boolean          @default(false)
  displayOrder    Int              @default(0)
  entries         SizeGuideEntry[]
  products        Product[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SizeGuideEntry {
  id           String    @id @default(uuid())
  sizeGuideId  String
  sizeGuide    SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)
  sizeName     String    // e.g. "XS", "S", "M", "L", "XL"
  measurements String    // JSON object e.g. {"Bust":"32","Waist":"26","Hip":"34","Length":"40"}
  notes        String?   // Size-specific notes
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────
// Pre-order Payment Methods
// ─────────────────────────────────────────────────────

model PreOrderPaymentMethod {
  id              String   @id @default(uuid())
  displayName     String   // e.g. "Easypaisa", "JazzCash", "Bank Transfer"
  methodType      String   // MOBILE_WALLET | BANK_TRANSFER | OTHER
  accountTitle    String?
  accountNumber   String?
  walletNumber    String?
  bankName        String?
  iban            String?
  qrCodeImagePath String?  // Internal file path — NOT a public URL
  instructions    String?  // Payment instructions shown to customer
  isActive        Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}
